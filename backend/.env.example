# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real configuration.
# ==============================================================================

# PostgreSQL Database Connection
DB_URL=jdbc:postgresql://localhost:5432/student_db
DB_USERNAME=postgres
DB_PASSWORD=change_me

# JWT (JSON Web Token) Security Configuration
# JWT_SECRET must be at least 256 bits (32+ characters / hex string) for HMAC-SHA256
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_bytes_long
JWT_EXPIRATION_MS=86400000

# Dedicated System Administrator Credentials
# This is the single authorized administrator account initialized on startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
